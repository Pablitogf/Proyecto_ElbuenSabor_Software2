@startuml C4_Contenedores
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_TOP_DOWN()
title Nivel 2 · Contenedores — Sistema El Buen Sabor

Person(personal, "Personal", "Mesero, cocinero, cajero, administrador")

System_Boundary(sistema, "Sistema El Buen Sabor") {
  Container(spa, "Aplicación web", "React 18 + TypeScript + Vite", "IU-01 tablet, IU-02 cocina, IU-03 caja, IU-04 administración y reservas")
  Container(api, "API y tiempo real", "Python 3.11 + FastAPI + Uvicorn", "Casos de uso, reglas de negocio, RBAC, WebSockets")
  ContainerDb(bd, "Base de datos relacional", "SQLite (desarrollo) / PostgreSQL (producción)", "Pedidos, inventario, kardex, pagos, facturas, reservas, jornadas, usuarios")
}

System_Ext(dian, "DIAN", "Facturación electrónica")
System_Ext(banco, "Entidad bancaria", "Pasarela de pagos")

Rel(personal, spa, "Usa", "Navegador Chrome / Safari")
Rel(spa, api, "Consume la API y recibe eventos", "HTTPS (JSON) / WSS")
Rel(api, bd, "Lee y escribe", "SQLAlchemy 2 (ORM)")
Rel(api, dian, "Factura XML y reporte diario", "SOAP / TLS 1.3")
Rel(api, banco, "Autorización de tarjeta", "REST / TLS 1.3")
@enduml
